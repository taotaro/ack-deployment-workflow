services:
  app:
    image: ${IMAGE_URL}:${DEPLOY_CHANNEL}
    restart: unless-stopped
    env_file:
      - app.env
    ports:
      - "__INIT_VPS_HOST_PORT__:__INIT_APP_PORT__"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:__INIT_APP_PORT____INIT_HEALTH_PATH__ >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 5
